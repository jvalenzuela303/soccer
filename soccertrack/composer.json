{
    "name": "truetech/soccertrack",
    "description": "Plugin WordPress de gestión de torneos de fútbol corporativos multi-torneo.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.2",
        "phpoffice/phpspreadsheet": "^2.1"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        }
    },
    "autoload": {
        "psr-4": {
            "SportsLeague\\": "includes/"
        },
        "exclude-from-classmap": [
            "includes/class-soccertrack-*.php",
            "includes/enum-*.php"
        ]
    }
}
